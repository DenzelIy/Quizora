{
  "name": "quizora",
  "private": true,
  "version": "1.0.0",
  "description": "Quizora - Offline Multiplayer Quiz Game",
  "main": "electron/main.cjs",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n shared,backend,frontend -c blue,green,magenta \"npm run dev -w shared\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:seed": "npm run db:seed -w backend",
    "electron:dev": "electron electron/main.cjs",
    "electron:rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.1"
  }
}
